{
  "id": "dk.kitchey.homey",
  "version": "1.2.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": ["local"],
  "brandColor": "#0d9e72",
  "name": {
    "en": "Kitchey",
    "da": "Kitchey"
  },
  "description": {
    "en": "See what's in your fridge, freezer and pantry, get expiry warnings and manage the shopping list from Homey.",
    "da": "Se hvad der er i køleskab, fryser og skab, få besked om udløb og styr indkøbslisten fra Homey."
  },
  "tags": {
    "en": ["kitchen", "food", "fridge", "freezer", "pantry", "shopping list", "expiry", "inventory"],
    "da": ["køkken", "mad", "køleskab", "fryser", "skab", "indkøbsliste", "udløb", "lager"]
  },
  "category": ["tools"],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Kitchey",
    "email": "kundeservice@aihuset.dk"
  },
  "support": "mailto:kundeservice@aihuset.dk",
  "homepage": "https://aihuset.dk/kitchey",
  "source": "https://github.com/ZeppDK/kitchey-integrations",
  "bugs": {
    "url": "https://github.com/ZeppDK/kitchey-integrations/issues"
  },
  "api": {
    "testConnection": {
      "method": "POST",
      "path": "/test"
    },
    "getStatus": {
      "method": "GET",
      "path": "/status"
    }
  },
  "capabilities": {
    "measure_item_count": {
      "type": "number",
      "title": { "en": "Items in stock", "da": "Varer på lager" },
      "units": { "en": "items", "da": "varer" },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/inventory.svg",
      "insights": true
    },
    "measure_expiring_3d": {
      "type": "number",
      "title": { "en": "Expiring within 3 days", "da": "Udløber inden 3 dage" },
      "units": { "en": "items", "da": "varer" },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/expiry.svg",
      "insights": true
    },
    "measure_expiring_7d": {
      "type": "number",
      "title": { "en": "Expiring within 7 days", "da": "Udløber inden 7 dage" },
      "units": { "en": "items", "da": "varer" },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/expiry.svg",
      "insights": true
    },
    "measure_expired": {
      "type": "number",
      "title": { "en": "Expired", "da": "Udløbet" },
      "units": { "en": "items", "da": "varer" },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/expired.svg",
      "insights": true
    },
    "alarm_expired": {
      "type": "boolean",
      "title": { "en": "Expired items alarm", "da": "Alarm: udløbede varer" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/alarm.svg",
      "insights": true,
      "insightsTitleTrue": { "en": "Expired items in stock", "da": "Udløbede varer på lager" },
      "insightsTitleFalse": { "en": "No expired items", "da": "Ingen udløbede varer" }
    },
    "kitchey_next_expiring": {
      "type": "string",
      "title": { "en": "Next to expire", "da": "Udløber næste gang" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/next-expiry.svg"
    },
    "kitchey_latest_item": {
      "type": "string",
      "title": { "en": "Latest added", "da": "Senest tilføjet" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/latest-item.svg"
    },
    "measure_shopping_count": {
      "type": "number",
      "title": { "en": "Open shopping items", "da": "Åbne indkøb" },
      "units": { "en": "items", "da": "punkter" },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/shopping-count.svg",
      "insights": true
    },
    "kitchey_shopping_list": {
      "type": "string",
      "title": { "en": "Shopping list", "da": "Indkøbsliste" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/shopping-list.svg"
    },
    "shopping_item": {
      "type": "string",
      "title": { "en": "Item", "da": "Vare" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/shopping-item.svg"
    }
  },
  "drivers": [
    {
      "id": "household",
      "name": { "en": "Household overview", "da": "Husstand (overblik)" },
      "class": "other",
      "capabilities": [
        "measure_item_count",
        "measure_expiring_3d",
        "measure_expiring_7d",
        "measure_expired",
        "measure_shopping_count",
        "alarm_expired",
        "kitchey_next_expiring",
        "kitchey_latest_item"
      ],
      "images": {
        "small": "/drivers/household/assets/images/small.png",
        "large": "/drivers/household/assets/images/large.png",
        "xlarge": "/drivers/household/assets/images/xlarge.png"
      },
      "pair": [
        { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
        { "id": "add_devices", "template": "add_devices" }
      ]
    },
    {
      "id": "storage-unit",
      "name": { "en": "Storage unit", "da": "Opbevaringssted" },
      "class": "other",
      "capabilities": [
        "measure_item_count",
        "measure_expiring_3d",
        "measure_expiring_7d",
        "measure_expired",
        "alarm_expired",
        "kitchey_next_expiring",
        "kitchey_latest_item"
      ],
      "images": {
        "small": "/drivers/storage-unit/assets/images/small.png",
        "large": "/drivers/storage-unit/assets/images/large.png",
        "xlarge": "/drivers/storage-unit/assets/images/xlarge.png"
      },
      "pair": [
        { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
        { "id": "add_devices", "template": "add_devices" }
      ],
      "settings": [
        {
          "id": "storage_unit_id",
          "type": "label",
          "label": { "en": "Storage unit ID", "da": "Opbevaringssted-ID" },
          "value": ""
        },
        {
          "id": "list_type",
          "type": "label",
          "label": { "en": "Type", "da": "Type" },
          "value": ""
        }
      ]
    },
    {
      "id": "shopping",
      "name": { "en": "Shopping list", "da": "Indkøbsliste" },
      "class": "other",
      "capabilities": ["measure_shopping_count", "kitchey_shopping_list"],
      "images": {
        "small": "/drivers/shopping/assets/images/small.png",
        "large": "/drivers/shopping/assets/images/large.png",
        "xlarge": "/drivers/shopping/assets/images/xlarge.png"
      },
      "pair": [
        { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
        { "id": "add_devices", "template": "add_devices" }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "item_expires_soon",
        "highlight": true,
        "title": { "en": "An item expires within X days", "da": "En vare udløber inden for X dage" },
        "titleFormatted": { "en": "An item expires within [[days]] days", "da": "En vare udløber inden for [[days]] dage" },
        "hint": { "en": "Fires once per item per day while the item is within the window.", "da": "Udløses én gang pr. vare pr. dag, så længe varen er inden for perioden." },
        "args": [
          { "type": "number", "name": "days", "title": { "en": "Days", "da": "Dage" }, "min": 0, "max": 30, "step": 1, "placeholder": { "en": "3", "da": "3" } }
        ],
        "tokens": [
          { "name": "item_name", "type": "string", "title": { "en": "Item", "da": "Vare" }, "example": { "en": "Milk", "da": "Mælk" } },
          { "name": "quantity", "type": "number", "title": { "en": "Quantity", "da": "Antal" }, "example": 2 },
          { "name": "unit", "type": "string", "title": { "en": "Unit", "da": "Enhed" }, "example": "stk" },
          { "name": "storage_unit", "type": "string", "title": { "en": "Storage unit", "da": "Opbevaringssted" }, "example": { "en": "Fridge", "da": "Køleskab" } },
          { "name": "expiry_date", "type": "string", "title": { "en": "Expiry date", "da": "Udløbsdato" }, "example": "2026-11-01" },
          { "name": "days_left", "type": "number", "title": { "en": "Days left", "da": "Dage tilbage" }, "example": 2 }
        ]
      },
      {
        "id": "item_expires_today",
        "title": { "en": "An item expires today", "da": "En vare udløber i dag" },
        "tokens": [
          { "name": "item_name", "type": "string", "title": { "en": "Item", "da": "Vare" }, "example": { "en": "Milk", "da": "Mælk" } },
          { "name": "quantity", "type": "number", "title": { "en": "Quantity", "da": "Antal" }, "example": 2 },
          { "name": "unit", "type": "string", "title": { "en": "Unit", "da": "Enhed" }, "example": "stk" },
          { "name": "storage_unit", "type": "string", "title": { "en": "Storage unit", "da": "Opbevaringssted" }, "example": { "en": "Fridge", "da": "Køleskab" } },
          { "name": "expiry_date", "type": "string", "title": { "en": "Expiry date", "da": "Udløbsdato" }, "example": "2026-11-01" }
        ]
      },
      {
        "id": "item_expired",
        "title": { "en": "An item has expired", "da": "En vare er udløbet" },
        "hint": { "en": "Fires once per item, the first time it is seen past its expiry date.", "da": "Udløses én gang pr. vare, første gang den ses efter udløbsdatoen." },
        "tokens": [
          { "name": "item_name", "type": "string", "title": { "en": "Item", "da": "Vare" }, "example": { "en": "Milk", "da": "Mælk" } },
          { "name": "quantity", "type": "number", "title": { "en": "Quantity", "da": "Antal" }, "example": 2 },
          { "name": "unit", "type": "string", "title": { "en": "Unit", "da": "Enhed" }, "example": "stk" },
          { "name": "storage_unit", "type": "string", "title": { "en": "Storage unit", "da": "Opbevaringssted" }, "example": { "en": "Fridge", "da": "Køleskab" } },
          { "name": "expiry_date", "type": "string", "title": { "en": "Expiry date", "da": "Udløbsdato" }, "example": "2026-11-01" }
        ]
      },
      {
        "id": "item_added",
        "title": { "en": "An item was added to stock", "da": "En vare blev lagt på lager" },
        "tokens": [
          { "name": "item_name", "type": "string", "title": { "en": "Item", "da": "Vare" }, "example": { "en": "Milk", "da": "Mælk" } },
          { "name": "quantity", "type": "number", "title": { "en": "Quantity", "da": "Antal" }, "example": 2 },
          { "name": "unit", "type": "string", "title": { "en": "Unit", "da": "Enhed" }, "example": "stk" },
          { "name": "storage_unit", "type": "string", "title": { "en": "Storage unit", "da": "Opbevaringssted" }, "example": { "en": "Fridge", "da": "Køleskab" } },
          { "name": "expiry_date", "type": "string", "title": { "en": "Expiry date", "da": "Udløbsdato" }, "example": "2026-11-01" }
        ]
      },
      {
        "id": "item_removed",
        "title": { "en": "An item was removed from stock", "da": "En vare blev fjernet fra lageret" },
        "hint": { "en": "Fires when an item is used up, deleted or set to zero.", "da": "Udløses når en vare er brugt op, slettet eller sat til nul." },
        "tokens": [
          { "name": "item_name", "type": "string", "title": { "en": "Item", "da": "Vare" }, "example": { "en": "Milk", "da": "Mælk" } },
          { "name": "quantity", "type": "number", "title": { "en": "Quantity", "da": "Antal" }, "example": 2 },
          { "name": "unit", "type": "string", "title": { "en": "Unit", "da": "Enhed" }, "example": "stk" },
          { "name": "storage_unit", "type": "string", "title": { "en": "Storage unit", "da": "Opbevaringssted" }, "example": { "en": "Fridge", "da": "Køleskab" } },
          { "name": "expiry_date", "type": "string", "title": { "en": "Expiry date", "da": "Udløbsdato" }, "example": "2026-11-01" }
        ]
      },
      {
        "id": "shopping_item_added",
        "highlight": true,
        "title": { "en": "An item was added to the shopping list", "da": "Et punkt blev sat på indkøbslisten" },
        "tokens": [
          { "name": "item_name", "type": "string", "title": { "en": "Item", "da": "Vare" }, "example": { "en": "Coffee", "da": "Kaffe" } },
          { "name": "quantity", "type": "number", "title": { "en": "Quantity", "da": "Antal" }, "example": 1 },
          { "name": "unit", "type": "string", "title": { "en": "Unit", "da": "Enhed" }, "example": "stk" },
          { "name": "added_by", "type": "string", "title": { "en": "Added by", "da": "Tilføjet af" }, "example": "Anna" }
        ]
      },
      {
        "id": "shopping_item_checked",
        "title": { "en": "A shopping item was checked off", "da": "Et indkøb blev afkrydset" },
        "tokens": [
          { "name": "item_name", "type": "string", "title": { "en": "Item", "da": "Vare" }, "example": { "en": "Coffee", "da": "Kaffe" } },
          { "name": "quantity", "type": "number", "title": { "en": "Quantity", "da": "Antal" }, "example": 1 },
          { "name": "unit", "type": "string", "title": { "en": "Unit", "da": "Enhed" }, "example": "stk" },
          { "name": "checked_by", "type": "string", "title": { "en": "Checked by", "da": "Afkrydset af" }, "example": "Anna" }
        ]
      },
      {
        "id": "shopping_item_removed",
        "title": { "en": "A shopping item was removed", "da": "Et punkt blev fjernet fra indkøbslisten" },
        "tokens": [
          { "name": "item_name", "type": "string", "title": { "en": "Item", "da": "Vare" }, "example": { "en": "Coffee", "da": "Kaffe" } },
          { "name": "quantity", "type": "number", "title": { "en": "Quantity", "da": "Antal" }, "example": 1 },
          { "name": "unit", "type": "string", "title": { "en": "Unit", "da": "Enhed" }, "example": "stk" }
        ]
      },
      {
        "id": "shopping_list_done",
        "title": { "en": "The shopping list is complete", "da": "Indkøbslisten er klaret" },
        "hint": { "en": "Fires when the last open item is checked off or removed.", "da": "Udløses når det sidste åbne punkt afkrydses eller fjernes." }
      },
      {
        "id": "shopping_count_above",
        "title": { "en": "Shopping list grows above X items", "da": "Indkøbslisten vokser til over X punkter" },
        "titleFormatted": { "en": "Shopping list grows above [[count]] open items", "da": "Indkøbslisten vokser til over [[count]] åbne punkter" },
        "args": [
          { "type": "number", "name": "count", "title": { "en": "Count", "da": "Antal" }, "min": 0, "max": 100, "step": 1, "placeholder": { "en": "10", "da": "10" } }
        ]
      }
    ],
    "conditions": [
      {
        "id": "has_in_stock",
        "highlight": true,
        "title": { "en": "A product !{{is|isn't}} in stock", "da": "Et produkt !{{er|er ikke}} på lager" },
        "titleFormatted": { "en": "[[product]] !{{is|isn't}} in stock (at least [[quantity]])", "da": "[[product]] !{{er|er ikke}} på lager (mindst [[quantity]])" },
        "args": [
          { "type": "autocomplete", "name": "product", "title": { "en": "Product", "da": "Produkt" }, "placeholder": { "en": "Milk", "da": "Mælk" } },
          { "type": "number", "name": "quantity", "title": { "en": "Minimum quantity", "da": "Mindste antal" }, "min": 1, "step": 1, "placeholder": { "en": "1", "da": "1" } }
        ]
      },
      {
        "id": "is_on_shopping_list",
        "title": { "en": "An item !{{is|isn't}} on the shopping list", "da": "En vare !{{står|står ikke}} på indkøbslisten" },
        "titleFormatted": { "en": "[[name]] !{{is|isn't}} on the shopping list", "da": "[[name]] !{{står|står ikke}} på indkøbslisten" },
        "args": [
          { "type": "text", "name": "name", "title": { "en": "Item name", "da": "Varenavn" }, "placeholder": { "en": "Coffee", "da": "Kaffe" } }
        ]
      },
      {
        "id": "has_expired_items",
        "title": { "en": "There !{{are|are no}} expired items", "da": "Der !{{er|er ikke}} udløbede varer" },
        "titleFormatted": { "en": "There !{{are|are no}} expired items in [[unit]]", "da": "Der !{{er|er ikke}} udløbede varer i [[unit]]" },
        "args": [
          { "type": "autocomplete", "name": "unit", "title": { "en": "Storage unit", "da": "Opbevaringssted" }, "placeholder": { "en": "Whole household", "da": "Hele husstanden" } }
        ]
      },
      {
        "id": "items_expiring_within",
        "title": { "en": "Items !{{are|aren't}} expiring within X days", "da": "Varer !{{udløber|udløber ikke}} inden for X dage" },
        "titleFormatted": { "en": "Items in [[unit]] !{{are|aren't}} expiring within [[days]] days", "da": "Varer i [[unit]] !{{udløber|udløber ikke}} inden for [[days]] dage" },
        "args": [
          { "type": "autocomplete", "name": "unit", "title": { "en": "Storage unit", "da": "Opbevaringssted" }, "placeholder": { "en": "Whole household", "da": "Hele husstanden" } },
          { "type": "number", "name": "days", "title": { "en": "Days", "da": "Dage" }, "min": 0, "max": 30, "step": 1, "placeholder": { "en": "3", "da": "3" } }
        ]
      },
      {
        "id": "shopping_has_more_than",
        "title": { "en": "Shopping list !{{has|doesn't have}} more than X open items", "da": "Indkøbslisten !{{har|har ikke}} mere end X åbne punkter" },
        "titleFormatted": { "en": "Shopping list !{{has|doesn't have}} more than [[count]] open items", "da": "Indkøbslisten !{{har|har ikke}} mere end [[count]] åbne punkter" },
        "args": [
          { "type": "number", "name": "count", "title": { "en": "Count", "da": "Antal" }, "min": 0, "max": 100, "step": 1, "placeholder": { "en": "0", "da": "0" } }
        ]
      }
    ],
    "actions": [
      {
        "id": "add_to_shopping",
        "highlight": true,
        "title": { "en": "Add an item to the shopping list", "da": "Sæt en vare på indkøbslisten" },
        "titleFormatted": { "en": "Add [[quantity]] [[unit]] [[name]] to the shopping list", "da": "Sæt [[quantity]] [[unit]] [[name]] på indkøbslisten" },
        "hint": { "en": "If the name matches a catalog product it is linked to that product.", "da": "Matcher navnet et katalogprodukt, kobles punktet til produktet." },
        "args": [
          { "type": "text", "name": "name", "title": { "en": "Item name", "da": "Varenavn" }, "placeholder": { "en": "Coffee", "da": "Kaffe" } },
          { "type": "number", "name": "quantity", "title": { "en": "Quantity", "da": "Antal" }, "min": 1, "step": 1, "placeholder": { "en": "1", "da": "1" } },
          { "type": "text", "name": "unit", "title": { "en": "Unit", "da": "Enhed" }, "placeholder": { "en": "pcs", "da": "stk" }, "required": false }
        ]
      },
      {
        "id": "check_shopping_item",
        "title": { "en": "Check off a shopping item", "da": "Afkryds et indkøb" },
        "titleFormatted": { "en": "Check off [[item]] on the shopping list", "da": "Afkryds [[item]] på indkøbslisten" },
        "args": [
          { "type": "autocomplete", "name": "item", "title": { "en": "Item", "da": "Vare" }, "placeholder": { "en": "Coffee", "da": "Kaffe" } }
        ]
      },
      {
        "id": "check_shopping_item_by_name",
        "title": { "en": "Check off a shopping item by name", "da": "Afkryds et indkøb efter navn" },
        "titleFormatted": { "en": "Check off [[name]] on the shopping list", "da": "Afkryds [[name]] på indkøbslisten" },
        "args": [
          { "type": "text", "name": "name", "title": { "en": "Item name", "da": "Varenavn" }, "placeholder": { "en": "Coffee", "da": "Kaffe" } }
        ]
      },
      {
        "id": "delete_shopping_item",
        "title": { "en": "Remove a shopping item", "da": "Fjern et indkøb" },
        "titleFormatted": { "en": "Remove [[item]] from the shopping list", "da": "Fjern [[item]] fra indkøbslisten" },
        "args": [
          { "type": "autocomplete", "name": "item", "title": { "en": "Item", "da": "Vare" }, "placeholder": { "en": "Coffee", "da": "Kaffe" } }
        ]
      },
      {
        "id": "delete_shopping_item_by_name",
        "title": { "en": "Remove a shopping item by name", "da": "Fjern et indkøb efter navn" },
        "titleFormatted": { "en": "Remove [[name]] from the shopping list", "da": "Fjern [[name]] fra indkøbslisten" },
        "args": [
          { "type": "text", "name": "name", "title": { "en": "Item name", "da": "Varenavn" }, "placeholder": { "en": "Coffee", "da": "Kaffe" } }
        ]
      },
      {
        "id": "clear_checked_shopping",
        "title": { "en": "Clear checked shopping items", "da": "Ryd afkrydsede indkøb" }
      },
      {
        "id": "get_shopping_list_text",
        "title": { "en": "Get the shopping list as text", "da": "Hent indkøbslisten som tekst" },
        "hint": { "en": "Returns the open items as a comma-separated text, e.g. for notifications or speech.", "da": "Giver de åbne punkter som kommasepareret tekst, fx til notifikationer eller oplæsning." },

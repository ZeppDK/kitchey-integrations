# ── Påkrævet ──────────────────────────────────────────────────────────────
DB_PASSWORD=skift_mig_til_noget_sikkert
JWT_SECRET=skift_mig_til_noget_langt_og_tilfaeldigt
APP_URL=https://kitchey.dit-domain.dk

# ── Valgfrit ──────────────────────────────────────────────────────────────
# Port som serveren eksponeres på (default: 3035)
PORT=3035

# Registreringspolitik:
#   false (default) = kun første bruger på en tom database kan registrere sig.
#                     Alle efterfølgende brugere inviteres via husstand-kode fra ejeren.
#   true            = alle kan oprette en konto (åben server).
REGISTRATION_OPEN=false

# ── Email / password-nulstilling (valgfrit) ────────────────────────────────
# Uden SMTP vises reset-link kun i server-loggen.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=din@email.dk
# SMTP_PASS=dit-app-password
# SMTP_FROM="Kitchey" <din@email.dk>

# ── Push-notifikationer (valgfrit) ────────────────────────────────────────
# Android FCM — Firebase service account JSON som én linje
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

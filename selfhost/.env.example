# Kopiér til .env og udfyld. Læses af docker-compose.yml.
# SELF_HOSTED sættes af compose og skal ikke stå her.

# ── Påkrævet ──────────────────────────────────────────────────────────────
# Kun bogstaver og tal (indgår i DATABASE_URL)
DB_PASSWORD=skift_mig_til_noget_sikkert
# Min. 32 tegn. Generér med: openssl rand -hex 32
JWT_SECRET=skift_mig_til_noget_langt_og_tilfaeldigt
# Serverens offentlige URL (bruges i mails)
APP_URL=https://kitchey.dit-domain.dk

# ── Valgfrit ──────────────────────────────────────────────────────────────
# Port på værten (default: 3035)
PORT=3035
# Tidszone (default: Europe/Copenhagen)
TZ=Europe/Copenhagen
# false (default): kun første bruger og invitationskode. true: alle kan oprette konto.
REGISTRATION_OPEN=false

# ── Email / password-nulstilling ──────────────────────────────────────────
# Uden SMTP står reset-linket i: docker compose logs app
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=din@email.dk
# SMTP_PASS=dit-app-password
# SMTP_FROM=din@email.dk

# ── Native push (valgfrit) ────────────────────────────────────────────────
# Uden disse starter serveren fint, men udløbsvarsler sendes ikke til telefoner.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   (Android, én linje)
# APNS_KEY=-----BEGIN PRIVATE KEY-----
MIGT...
-----END PRIVATE KEY-----   (iOS, .p8-indholdet som én linje med 
)
# APNS_KEY_ID=...
# APNS_TEAM_ID=...
